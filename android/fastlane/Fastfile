default_platform(:android)

def require_android_release_signing!
  required = %w[
    ANDROID_KEYSTORE_PATH
    ANDROID_KEYSTORE_PASSWORD
    ANDROID_KEY_ALIAS
    ANDROID_KEY_PASSWORD
  ]
  missing = required.select { |name| ENV[name].to_s.strip.empty? }
  return if missing.empty?

  UI.user_error!("Missing Android release signing variables: #{missing.join(', ')}")
end

platform :android do
  desc "Run Android unit tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Build production-signed release APKs"
  lane :apk do
    require_android_release_signing!
    gradle(task: "clean assembleRelease")
  end

  desc "Build an AAB and upload it to the Play internal track"
  lane :internal do
    require_android_release_signing!
    json_key = ENV["GOOGLE_PLAY_JSON_KEY_PATH"].to_s.strip
    UI.user_error!("GOOGLE_PLAY_JSON_KEY_PATH is required") if json_key.empty?

    gradle(task: "clean bundleRelease")
    upload_to_play_store(
      aab: File.expand_path("../app/build/outputs/bundle/release/app-release.aab", __dir__),
      json_key: json_key,
      track: "internal"
    )
  end
end

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/glucose_widget_root" android:layout_width="match_parent"
  android:layout_height="match_parent" android:orientation="vertical"
  android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp"
  android:background="@drawable/glucose_summary_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="20dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/summary_day" android:layout_width="0dp" android:layout_weight="1"
      android:layout_height="wrap_content" android:text="@string/summary_today" android:maxLines="1"
      android:textColor="#A6B7CC" android:textSize="10sp" android:includeFontPadding="false" />
    <TextView android:id="@+id/summary_glucose" android:layout_width="wrap_content"
      android:layout_height="wrap_content" android:text="—" android:textColor="#F3F7FF"
      android:textSize="17sp" android:textStyle="bold" android:textDirection="ltr" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/summary_range_panel" android:layout_width="match_parent"
    android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
    android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/summary_tir" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="—" android:textColor="#68DFC7"
        android:textSize="25sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
        <TextView android:id="@+id/summary_range_title" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="@string/summary_time_in_range"
          android:textColor="#D7E3F3" android:textSize="10sp" android:maxLines="1" android:includeFontPadding="false" />
        <TextView android:id="@+id/summary_coverage" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:textColor="#A6B7CC" android:textSize="8sp"
          android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/summary_range_ring" android:layout_width="match_parent"
      android:layout_height="3dp" android:layout_marginTop="2dp" android:scaleType="fitXY"
      android:importantForAccessibility="no" />
  </LinearLayout>
  <LinearLayout android:id="@+id/summary_comparison_button" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:minHeight="37dp" android:orientation="vertical" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/summary_insulin_total" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1"
        android:textColor="#F3F7FF" android:textSize="11sp" android:textStyle="bold" android:includeFontPadding="false"
        android:gravity="start" android:textAlignment="viewStart" android:layout_marginEnd="4dp" />
      <TextView android:id="@+id/summary_compact_split_legend" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="#D7E3F3" android:textSize="10sp"
        android:maxLines="1" android:includeFontPadding="false" />
    </LinearLayout>
    <ImageView android:id="@+id/summary_insulin_split" android:layout_width="match_parent"
      android:layout_height="5dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
      android:scaleType="fitXY" />
    <TextView android:id="@+id/summary_comparison_title" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
      android:textColor="#A6B7CC" android:textSize="8sp" android:includeFontPadding="false" />
  </LinearLayout>
</LinearLayout>

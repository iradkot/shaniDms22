    "verify:rules": "yarn test:rules:firestore && yarn test:rules:storage",
    "verify:rewrite": "yarn security:release && yarn typecheck:rewrite && yarn lint:rewrite && yarn test:rewrite",
    "verify:web": "yarn typecheck:web && yarn lint:web && yarn test:web && yarn build:web",
    "verify:all": "yarn security:release && yarn verify:ios-release-config && yarn verify:metro-config && yarn verify:chart-worklets && yarn typecheck:rewrite && yarn typecheck:web && yarn lint:rewrite && yarn test:all --silent && yarn verify:functions && yarn verify:rules && yarn build:web",
    "lint": "eslint .",
    "build:android:debug": "node scripts/run-android-gradle.mjs :app:assembleDebug",
    "build:android:preview": "node scripts/run-android-gradle.mjs -PALLOW_DEBUG_RELEASE_SIGNING=true :app:assembleRelease",
    "build:android:release": "node scripts/run-android-gradle.mjs --require-release-signing :app:assembleRelease",
    "build:android:aab": "node scripts/run-android-gradle.mjs --require-release-signing :app:bundleRelease",
    "build:preview:all": "yarn verify:all && yarn bundle:frontend:android && yarn bundle:frontend:ios && yarn build:android:preview",
    "bundle:frontend:android": "node scripts/bundle-frontend.mjs android",
    "bundle:frontend:ios": "node scripts/bundle-frontend.mjs ios",
    "publish_testflight": "cd ios && bundle exec fastlane ios beta --verbose",
    "log-android": "adb logcat *:S ReactNative:V ReactNativeJS:V ReactNativeJNI:V com.shanidms22:D System.err:W",
    "e2e:maestro": "maestro test e2e/maestro",
    "e2e:maestro:android": "maestro test e2e/maestro",
    "e2e:maestro:android:smoke": "maestro test e2e/maestro/product-hub-smoke.yaml",
    "e2e:contracts": "jest __tests__/e2e --runInBand",
    "e2e:maestro:install:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-maestro-windows.ps1",
    "e2e:maestro:android:summary": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-maestro-android.ps1",
    "perf:cgm-selection": "jest __tests__/perf/cgmSelection.perf.test.ts --runInBand",
    "perf:app": "node scripts/check-app-performance.cjs",
    "perf:app:browser": "node scripts/check-app-performance.cjs --browser",
    "build:perf:web": "vite build --config vite.performance.config.mjs",
    "preview:perf:web": "vite preview --config vite.performance.config.mjs --host 127.0.0.1"

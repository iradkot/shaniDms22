# Full Cloud KMS CryptoKey resource name. Never put key material here.
KMS_KEY_NAME=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY

# Comma-separated exact web origins. Native apps do not send Origin.
ALLOWED_CORS_ORIGINS=https://app.example.com

# Server allowlist. Add models deliberately; clients cannot override it.
ALLOWED_LLM_MODELS=gpt-5.5
